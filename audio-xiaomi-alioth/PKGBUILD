pkgname=audio-xiaomi-alioth
pkgdesc="Audio configuration for Xiaomi POCO F3 / Redmi K40 / Mi 11X (alioth): ALSA UCM2, WirePlumber and speaker EQ"
pkgver=1
pkgrel=1
url="https://github.com/rmuxnet/PKGBUILDs-alioth"
license=('MIT')
arch=('any')
depends=(
	'alsa-ucm-conf'
)
optdepends=(
	'pipewire: speaker EQ filter-chain'
	'wireplumber: speaker node settings'
)
source=(
	'ucm2-xiaomi-alioth.conf'
	'ucm2-HiFi.conf'
	'wireplumber-51-alioth.conf'
	'pipewire-50-alioth-speaker-eq.conf'
)
sha512sums=(
	'SKIP'
	'SKIP'
	'SKIP'
	'SKIP'
)

package() {
	# Card name is "xiaomi-alioth" from DTS &sound { model = "xiaomi-alioth"; }
	install -Dm644 "${srcdir}/ucm2-xiaomi-alioth.conf" \
		"${pkgdir}/usr/share/alsa/ucm2/conf.d/sm8250/xiaomi-alioth.conf"
	install -Dm644 "${srcdir}/ucm2-HiFi.conf" \
		"${pkgdir}/usr/share/alsa/ucm2/Qualcomm/sm8250/HiFi_alioth.conf"

	install -Dm644 "${srcdir}/wireplumber-51-alioth.conf" \
		"${pkgdir}/usr/share/wireplumber/wireplumber.conf.d/51-alioth.conf"

	install -Dm644 "${srcdir}/pipewire-50-alioth-speaker-eq.conf" \
		"${pkgdir}/usr/share/pipewire/pipewire.conf.d/50-alioth-speaker-eq.conf"
}
