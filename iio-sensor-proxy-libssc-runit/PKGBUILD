pkgname=iio-sensor-proxy-libssc-runit
pkgver=3.8
pkgrel=1
pkgdesc='IIO accelerometer sensor to input device proxy (Runit init scripts)'
arch=('any')
url='https://gitlab.freedesktop.org/hadess/iio-sensor-proxy/'
license=('GPL-2.0-or-later')
groups=('runit-pipa-armtix')
depends=('iio-sensor-proxy-libssc' 'runit')
_pkgname=iio-sensor-proxy
install="$pkgname.install"
source=("$_pkgname-libssc.run")
sha512sums=('SKIP')

package() {
	install -Dm755 "$srcdir"/$_pkgname-libssc.run "$pkgdir/etc/runit/sv/$_pkgname-libssc/run"
}