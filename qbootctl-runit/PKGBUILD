pkgname="qbootctl-runit"
pkgdesc="Mark current boot as successful in Android A/B interface"
pkgver=0.2.2
pkgrel=2
arch=('any')
url="https://github.com/linux-msm/qbootctl"
license=('GPL-3.0-or-later')
groups=('runit-pipa-armtix')
depends=('qbootctl' 'runit')
_pkgname=qbootctl
install="$pkgname.install"
source=("$_pkgname.run")
sha512sums=('SKIP')

package() {
	# Install runit service
	install -Dm755 "$srcdir/$_pkgname.run" "$pkgdir/etc/runit/sv/$_pkgname/run"
}