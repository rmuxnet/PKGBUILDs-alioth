pkgname="hexagonrpcd-runit"
pkgdesc="Qualcomm HexagonFS daemon (Runit init scripts)"
pkgver=0.4.0
pkgrel=2
arch=('any')
url="https://gitlab.com/sdm845-mainline/hexagonrpc/"
license=(GPL-3.0-or-later)
groups=('runit-pipa-armtix')
depends=('hexagonrpcd' 'runit')
_pkgname=hexagonrpcd
install="$pkgname.install"
source=(
    "$_pkgname-adsp-rootpd.run"
    "$_pkgname-adsp-sensorspd.run"
    "$_pkgname-sdsp.run"
)
sha512sums=(
    'SKIP'
    'SKIP'
    'SKIP'
)

package() {
    # Add Services for Runit
	install -Dm755 $srcdir/$_pkgname-adsp-rootpd.run "$pkgdir/etc/runit/sv/$_pkgname-adsp-rootpd/run"
	install -Dm755 $srcdir/$_pkgname-adsp-sensorspd.run "$pkgdir/etc/runit/sv/$_pkgname-adsp-sensorspd/run"
	install -Dm755 $srcdir/$_pkgname-sdsp.run "$pkgdir/etc/runit/sv/$_pkgname-sdsp/run"
}