# Maintainer: rmux

pkgbase=linux-firmware-alioth
pkgname=(
    linux-firmware-alioth-adreno
    linux-firmware-alioth-adsp
    linux-firmware-alioth-cdsp
    linux-firmware-alioth-ipa
    linux-firmware-alioth-slpi
    linux-firmware-alioth-venus
    linux-firmware-alioth-cirrus
    linux-firmware-alioth-focaltech
    linux-firmware-alioth-hexagonfs
)

_commit="95dfcdf6b154c00af3e093db82015cda90f4299a"
_srcdir="firmware-xiaomi-alioth-$_commit"
pkgver=20250605
pkgrel=1
pkgdesc="Firmware files for Xiaomi POCO F3 / Redmi K40 / Mi 11X (alioth)"
url="https://github.com/N1kroks/firmware-xiaomi-alioth"
arch=('any')
license=('custom')
makedepends=(git)
options=(!strip !debug)

source=(
    "$pkgbase-$pkgver.tar.gz::$url/archive/$_commit.tar.gz"
    "hexagon_firmware.files"
)

sha512sums=(
    'SKIP'
    'SKIP'
)

_pick() {
    local p="$1" f d; shift
    for f; do
        d="$srcdir/$p/${f#$pkgdir/}"
        mkdir -p "$(dirname "$d")"
        mv "$f" "$d"
        rmdir -p --ignore-fail-on-non-empty "$(dirname "$f")"
    done
}

package_linux-firmware-alioth-adreno() {
    pkgdesc="Xiaomi alioth Adreno firmware"
    depends=('linux-firmware-whence')
    license=('custom')

    install -Dm644 "$srcdir/$_srcdir"/lib/firmware/qcom/sm8250/xiaomi/alioth/a650_zap.mbn \
        -t "$pkgdir/usr/lib/firmware/qcom/sm8250/xiaomi/alioth/"
}

