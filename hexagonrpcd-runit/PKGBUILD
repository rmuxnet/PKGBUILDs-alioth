pkgname="hexagonrpcd-runit"
pkgdesc="Qualcomm HexagonFS daemon (Runit init scripts)"
pkgver=0.4.0
pkgrel=2
arch=('any')
url="https://gitlab.com/sdm845-mainline/hexagonrpc/"
license=(GPL-3.0-or-later)
groups=('runit-pipa-armtix')
depends=('hexagonrpcd' 'runit')
_pkgname=hexagonrpcd
install="$pkgname.install"
source=(
    "$_pkgname-adsp-rootpd.run"
    "$_pkgname-adsp-sensorspd.run"
    "$_pkgname-sdsp.run"
)
sha512sums=(
