#!/bin/bash

# sourcing our current rc.conf requires this to be a bash script
. /usr/lib/rc/functions

case "$1" in
    start)
        stat_busy "Setting system time"
        SWCLOCK_PATH/swclock-offset-boot || stat_die swclock-offset-boot
        stat_done
        ;;
    *)
        echo "usage: $0 {start}"
        exit 1
        ;;
esac