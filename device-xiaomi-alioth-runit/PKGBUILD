pkgname=device-xiaomi-alioth-runit
pkgdesc="Package containing Runit configurations for Xiaomi POCO F3 / Redmi K40 / Mi 11X (alioth)"
pkgver=1
pkgrel=1
url="https://github.com/rmuxnet/PKGBUILDs-alioth"
license=('MIT')
arch=('aarch64')
groups=('runit-alioth-armtix')
depends=(
	'device-xiaomi-alioth'
	'hexagonrpcd-runit'
	'qbootctl-runit'
	'iio-sensor-proxy-libssc-runit'
	'swclock-offset-runit'
	'runit'
)
source=(
	'hexagonrpcd.conf'
	'sensor-fix.sh'
)
sha512sums=(
	'SKIP'
	'SKIP'
)

package() {
	install -Dm644 "$srcdir"/hexagonrpcd.conf "$pkgdir"/etc/runit/sv/hexagonrpcd-sdsp/conf
	install -Dm644 "$srcdir"/hexagonrpcd.conf "$pkgdir"/etc/runit/sv/hexagonrpcd-adsp-rootpd/conf
	install -Dm644 "$srcdir"/hexagonrpcd.conf "$pkgdir"/etc/runit/sv/hexagonrpcd-adsp-sensorpd/conf

	install -Dm755 "${srcdir}/sensor-fix.sh" "${pkgdir}/usr/lib/elogind/system-sleep/sensor-fix.sh"
}
