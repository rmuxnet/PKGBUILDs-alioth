package_linux-firmware-alioth-hexagonfs() {
    pkgdesc="Xiaomi alioth hexagonfs (DSP/sensor/acdb) files"
    depends=('linux-firmware-whence')
    license=('custom')

    mkdir -p "$pkgdir"

    while IFS="" read -r _i || [ -n "$_i" ]; do
        [ ! -d $(dirname "$pkgdir/$_i") ] && mkdir -p "$(dirname "$pkgdir/$_i")"
        install -Dm644 "$srcdir/$_srcdir/$_i" "$pkgdir/$_i"
    done < "$srcdir/hexagon_firmware.files"
}
