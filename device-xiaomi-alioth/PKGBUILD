pkgname=device-xiaomi-alioth
pkgdesc="Package containing configurations for Xiaomi Mi 11i / Redmi K40 / POCO F3 (alioth)"
pkgver=1
pkgrel=1
url="https://postmarketos.org"
license=('MIT')
arch=('aarch64')
depends=(
	'audio-xiaomi-alioth'
	'bootmac'
	'hexagonrpcd'
	'alioth-kernel-hooks'
	'linux'
	'mesa'
	'mkbootimg'
	'qbootctl'
	'iio-sensor-proxy'
	'swclock-offset'
)
source=(
	'81-libssc-xiaomi-alioth.rules'
)
sha512sums=(
	'SKIP'
)

package() {
	# Install udev rules
	install -Dm644 "${srcdir}/81-libssc-xiaomi-alioth.rules" \
		"${pkgdir}/usr/lib/udev/rules.d/81-libssc-xiaomi-alioth.rules"
}
